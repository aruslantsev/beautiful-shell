if [ "${_BS_CONDA_INIT:-0}" -eq 1 ]; then
	case "${_BS_SHELL_NAME}" in
		bash|zsh)
			if [ -d "${HOME}/miniconda3" ]; then
				eval "$("${HOME}/miniconda3/bin/conda" shell."${_BS_SHELL_NAME}" hook)"
				conda deactivate

				if [ ! -f "${HOME}/.condarc" ]; then
					__bs_print_warn "${HOME}/.condarc is missing, creating it now"
					touch "${HOME}/.condarc"
				fi
				grep -i "changeps1:[[:space:]]*false" "${HOME}/.condarc" > /dev/null || conda config --set changeps1 False
			fi
			;;
	esac
fi
