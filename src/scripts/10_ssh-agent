if [ "${_BS_RUN_SSH_AGENT:-1}" -eq 1 ]; then
    if [ -d ~/.ssh ]; then
        unset SSH_ASKPASS
        SOCKET="$HOME/.ssh/ssh-agent.sock"

        if [ $(pgrep -u $USER -f "ssh-agent.*$SOCKET" | wc -l) -eq 0 ] && [ -S "$SOCKET" ]; then
            __bs_print_warn "No ssh-agent is running for socket $SOCKET but socket exists. Removing it."
            rm "$SOCKET"
        fi

        if [ $(pgrep -u $USER -f "ssh-agent.*$SOCKET" | wc -l) -ne 0 ] && [ ! -S "$SOCKET" ]; then
            __bs_print_warn "Socket does not exist but ssh-agent is running."
        fi

        if [ ! -S "$SOCKET" ]; then
            __bs_print_info "Starting ssh-agent"
            ssh-agent -a "$SOCKET" > /dev/null
            if [ ! -f ~/.ssh/config ]; then
                __bs_print_warn "~/.ssh/config does not exist, creating..."
                touch ~/.ssh/config;
            fi
            grep "AddKeysToAgent[[:space:]]yes" ~/.ssh/config > /dev/null || __bs_print_info 'Insert "AddKeysToAgent yes" into your ~/.ssh/config'
        fi

        export SSH_AUTH_SOCK="$SOCKET"
        export SSH_AGENT_PID=$(pgrep -u $USER -f "ssh-agent.*$SOCKET")
    else
        __bs_print_err "Directory ~/.ssh does not exist. ssh-agent failed to start"
    fi
fi